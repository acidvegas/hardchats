# HARDCHATS WebRTC Voice/Video Server - Developed by acidvegas (https://github.com/acidvegas/hardchats)
# hardchats/.env.example

# IRC settings
IRC_SERVER='irc.supernets.org'
IRC_PORT=7000
IRC_CHANNEL='#hardchats'


# Baked-in IRC bot (set to 0 to disable)
IRCBOT_ENABLED=1

# Stream every browser's media/E2EE debug log to the server log (troubleshooting only)
DIAG_LOGS=0

# Optional HTML shown in the page footer next to the version
FOOTER_NOTICE=''


# LiveKit SFU settings (generate a key pair with: docker run --rm livekit/livekit-server:v1.13.11 generate-keys)
LIVEKIT_URL='wss://hardchats.com/livekit'
LIVEKIT_API_KEY='changeme'
LIVEKIT_API_SECRET='changeme'


# Zulip join/leave announcements (optional)
ZULIP_BOT_EMAIL='hardchats-bot@supernets.org'
ZULIP_BOT_KEY=''
